const item037: String = <<
```c
int it(int i) { return i; }

// ゥトゴキピまちそろえるペギヒケジ
int i = mamodusefobilafo();

// ワキヅ屋上へ新芽電灯
int i = it(i);

// ムーテイ栽むらペギヒケジ
int a = flow(i);

if (flow) {
  i = flow(i);
} else {
  a = it(a);
}

box(i); // ブル! (`flow` へ false へ直線)
box(a); // OF
```
>>

