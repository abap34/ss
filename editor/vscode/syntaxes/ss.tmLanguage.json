{
  "scopeName": "source.ss",
  "name": "ss",
  "patterns": [
    { "include": "#comments" },
    { "include": "#block-string" },
    { "include": "#color-string" },
    { "include": "#double-string" },
    { "include": "#annotations" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#types" },
    { "include": "#function-call" },
    { "include": "#bare-call" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-semicolon.ss",
          "match": ";;.*$"
        }
      ]
    },
    "block-string": {
      "patterns": [
        {
          "name": "string.unquoted.block.ss",
          "begin": "<<[ \\t\\r]*(?:;;.*)?$",
          "end": "^[ \\t\\r]*>>",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.ss" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.ss" }
          }
        }
      ]
    },
    "double-string": {
      "patterns": [
        {
          "name": "string.quoted.double.ss",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.ss" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.ss" }
          }
        }
      ]
    },
    "color-string": {
      "patterns": [
        {
          "name": "constant.other.color.ss",
          "begin": "c\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.ss" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.ss" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ss",
          "match": "\\bfn/!|\\b(?:import|as|const|document|page|fn|let|with|return|end|type|enum|stages|show|if|else)\\b"
        },
        {
          "name": "storage.type.ss",
          "match": "\\b(?:Document|Page|Group|Placed|Placement|Anchor|String|Color|Number|Bool|Constraints|Path|Void|None|Selection)\\b"
        },
        {
          "name": "constant.language.boolean.ss",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "captures": {
            "0": { "name": "storage.modifier.annotation.ss" },
            "1": { "name": "entity.name.function.annotation.ss" }
          },
          "match": "@([A-Za-z_][A-Za-z0-9_]*)"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "captures": {
            "1": { "name": "keyword.control.ss" },
            "2": { "name": "entity.name.type.ss" }
          },
          "match": "\\b(enum|type)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=[<{])"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.ss",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.ss",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.ss",
          "match": "\\|=\\||/=/|\\|->|->|~!~|\\?\\.|\\?\\?|\\+\\+|\\|\\||//|::|==|!=|<=|>=|=|\\?|:|\\||&|~|\\.|,|!|<|>|\\-|\\+|\\*|/"
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "captures": {
            "1": { "name": "entity.name.namespace.ss" },
            "2": { "name": "entity.name.function.ss" },
            "3": { "name": "punctuation.section.group.begin.ss" }
          },
          "match": "\\b(?:([A-Za-z_][A-Za-z0-9_]*)::)?([A-Za-z_][A-Za-z0-9_]*!?)\\s*(\\()"
        }
      ]
    },
    "bare-call": {
      "patterns": [
        {
          "captures": {
            "1": { "name": "entity.name.function.ss" }
          },
          "match": "^(\\s*(?:[A-Za-z_][A-Za-z0-9_]*::)?[A-Za-z_][A-Za-z0-9_]*!?)(?=\\s|$)"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.ss",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
