{
  "name": "ss-language-support",
  "displayName": "ss-lang for VS Code",
  "description": "Language server powered editor support for ss slide source files.",
  "version": "0.7.3",
  "publisher": "abap34",
  "license": "Apache-2.0",
  "icon": "assets/logo.png",
  "homepage": "https://github.com/abap34/ss#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/abap34/ss.git",
    "directory": "editor/vscode"
  },
  "bugs": {
    "url": "https://github.com/abap34/ss/issues"
  },
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.85.0"
  },
  "scripts": {
    "compile": "node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "package": "npm run compile && vsce package",
    "test": "npm run compile && node ../../scripts/check-ss-toml-schema.js && node ../../tests/editor/vscode/controller/spec.mjs && node ../../tests/editor/vscode/request/spec.mjs && node ../../tests/editor/vscode/timing/spec.mjs"
  },
  "activationEvents": [
    "onLanguage:ss-slide",
    "onCommand:ss.editor.open",
    "onCommand:ss.editor.build",
    "onCommand:ss.checkCurrentFile"
  ],
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "ss",
    "slides",
    "presentation",
    "pdf",
    "lsp",
    "language server"
  ],
  "galleryBanner": {
    "color": "#1f2937",
    "theme": "dark"
  },
  "contributes": {
    "languages": [
      {
        "id": "ss-slide",
        "aliases": [
          "ss",
          "ss-slide"
        ],
        "extensions": [
          ".ss"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ss-slide",
        "scopeName": "source.ss",
        "path": "./syntaxes/ss.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "ss.editor.open",
        "title": "ss: Open WYSIWYG Editor"
      },
      {
        "command": "ss.editor.build",
        "title": "ss: Build WYSIWYG Preview"
      },
      {
        "command": "ss.checkCurrentFile",
        "title": "ss: Check Current File"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ss.editor.open",
          "when": "resourceLangId == ss-slide",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "ss.editor.open"
        },
        {
          "command": "ss.editor.build"
        },
        {
          "command": "ss.checkCurrentFile"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ss.editor.build",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorFocus && editorLangId == ss-slide"
      },
      {
        "command": "ss.editor.build",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "activeWebviewPanelId == ss.wysiwyg"
      }
    ],
    "configurationDefaults": {
      "[ss-slide]": {
        "editor.quickSuggestions": {
          "comments": "off",
          "strings": "off",
          "other": "on"
        },
        "editor.suggestOnTriggerCharacters": true,
        "editor.wordBasedSuggestions": "off"
      }
    },
    "configuration": {
      "title": "ss",
      "properties": {
        "ss.cli.path": {
          "type": "string",
          "default": "ss",
          "description": "Path to the ss executable used to launch `ss lsp`."
        },
        "ss.lsp.trace.server": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "description": "Trace communication with the ss language server."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  }
}
